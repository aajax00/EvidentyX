{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EVIDENTYX",
  "version": "../package.json",
  "identifier": "org.evidentyx.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EVIDENTYX",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#0b0f16",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Investigation numérique et reconstruction d'incidents",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Contributeurs EVIDENTYX",
    "copyright": "© 2026 Contributeurs EVIDENTYX — Apache 2.0",
    "license": "Apache-2.0",
    "homepage": "https://github.com/aajax00/EvidentyX",
    "longDescription": "Plateforme d'investigation numérique et de reconstruction d'incidents, entièrement hors ligne. Transforme des preuves numériques fragmentées (journaux, captures réseau) en enquêtes structurées, chronologiques et explicables. Aucune télémétrie, aucun compte, aucun envoi de données.",
    "linux": {
      "deb": {
        "section": "utils"
      },
      "appimage": {
        "bundleMediaFramework": false
      },
      "rpm": {
        "release": "1"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ]
      },
      "wix": {
        "language": [
          "fr-FR",
          "en-US"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
